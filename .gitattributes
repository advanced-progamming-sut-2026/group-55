# Keep text files consistent across Windows, Linux, and macOS.
* text=auto eol=lf

# Windows command scripts are more compatible with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit text formats used by this project.
*.java text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Never modify binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
